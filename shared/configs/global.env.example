# MyStack Global Environment Configuration
# Copy this file to each service directory as .env and customize as needed

# =============================================================================
# DOMAIN CONFIGURATION
# =============================================================================
DOMAIN=yourdomain.com
EMAIL=admin@yourdomain.com

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Generate strong passwords for production use
POSTGRES_PASSWORD=your_secure_postgres_password_here
REDIS_PASSWORD=your_secure_redis_password_here
N8N_BASIC_AUTH_PASSWORD=your_secure_n8n_auth_password_here
WEBUI_SECRET_KEY=your_secure_webui_secret_key_here

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================
# n8n Configuration
N8N_BASIC_AUTH_USER=admin
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
GENERIC_TIMEZONE=UTC

# Database Configuration
POSTGRES_DB=n8n
POSTGRES_USER=postgres
POSTGRES_NON_ROOT_USER=n8n
POSTGRES_NON_ROOT_PASSWORD=your_secure_n8n_password_here

# OpenWebUI Configuration
DEFAULT_USER_ROLE=admin
WEBUI_AUTH=True
ENABLE_SIGNUP=False

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION_LEVEL=6

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
DOZZLE_LEVEL=info
DOZZLE_TAILSIZE=300

# =============================================================================
# SSL CONFIGURATION
# =============================================================================
SSL_EMAIL=admin@yourdomain.com
SSL_AGREE_TERMS=true

# =============================================================================
# EXTERNAL STORAGE (for large files like LLM models)
# =============================================================================
OLLAMA_MODELS_PATH=/opt/ollama-models

# =============================================================================
# WEBHOOK URLS (update with your actual domain)
# =============================================================================
WEBHOOK_URL=https://n8n.yourdomain.com
OLLAMA_WEBHOOK_URL=https://ollama.yourdomain.com
